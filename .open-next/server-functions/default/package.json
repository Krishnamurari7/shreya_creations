{
  "name": "shreya-creations",
  "version": "1.0.0",
  "private": true,
  "description": "Shreya Creations — a 3D portfolio + shop + courses showcase with WhatsApp ordering. Next.js + Supabase.",
  "scripts": {
    "prebuild": "node scripts/generate-static-media-paths.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:opennext": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "test:rls": "node scripts/test-supabase-rls.mjs",
    "seed:phase8": "node scripts/phase8-seed.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.1",
    "jspdf": "^4.2.1",
    "next": "15.5.20",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-pdf": "^10.4.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "5.8.2",
    "wrangler": "^4.112.0"
  }
}
