# Supabase — get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The WhatsApp number that all order/enquiry buttons open (international format, no +, no spaces)
# Example for India: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Public site URL — used for Open Graph / social preview images (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://shreyacreations.in
